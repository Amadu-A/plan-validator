# .env.example
#
# Committed safe configuration catalog Plan Validator.
#
# Private `.env` остаётся sparse и содержит только реальные secrets.
# Application containers читают этот файл напрямую через Pydantic Settings.

# Compose/deployment identity.
COMPOSE_PROJECT_NAME=plan-validator

# Runtime environment.
PLAN_VALIDATOR_ENVIRONMENT=development

# Container wiring.
PLAN_VALIDATOR_RUNTIME_UID=1000
PLAN_VALIDATOR_RUNTIME_GID=1000
PLAN_VALIDATOR_BIND_IP=127.0.0.1
PLAN_VALIDATOR_GATEWAY_HOST_PORT=8000

# API Gateway application settings.
PLAN_VALIDATOR_GATEWAY__HOST=0.0.0.0
PLAN_VALIDATOR_GATEWAY__PORT=8000
PLAN_VALIDATOR_GATEWAY__DOCS_ENABLED=true
PLAN_VALIDATOR_GATEWAY_UPLOAD__MAX_MANAGED_SOURCE_BYTES=67108864

PLAN_VALIDATOR_INTERNAL_HTTP__CONNECT_TIMEOUT_SECONDS=3
PLAN_VALIDATOR_INTERNAL_HTTP__READ_TIMEOUT_SECONDS=30

PLAN_VALIDATOR_AUTH_SERVICE__BASE_URL=http://auth-service:8000
PLAN_VALIDATOR_CATALOG_SERVICE__BASE_URL=http://catalog-service:8000
PLAN_VALIDATOR_CONTEXT_SERVICE__BASE_URL=http://context-service:8000

PLAN_VALIDATOR_SESSION_COOKIE__NAME=plan_validator_session
PLAN_VALIDATOR_SESSION_COOKIE__MAX_AGE_SECONDS=604800
PLAN_VALIDATOR_SESSION_COOKIE__SECURE=false
PLAN_VALIDATOR_SESSION_COOKIE__SAME_SITE=lax
PLAN_VALIDATOR_SESSION_COOKIE__PATH=/

# Authentication Service safe database settings.
PLAN_VALIDATOR_AUTH_DATABASE__HOST=postgres
PLAN_VALIDATOR_AUTH_DATABASE__PORT=5432
PLAN_VALIDATOR_AUTH_DATABASE__DATABASE=plan_validator
PLAN_VALIDATOR_AUTH_DATABASE__USER=plan_validator
PLAN_VALIDATOR_AUTH_DATABASE__SCHEMA_NAME=auth
PLAN_VALIDATOR_AUTH_DATABASE__POOL_SIZE=10
PLAN_VALIDATOR_AUTH_DATABASE__MAX_OVERFLOW=10
PLAN_VALIDATOR_AUTH_DATABASE__POOL_TIMEOUT_SECONDS=30

PLAN_VALIDATOR_AUTH_SESSION__TTL_SECONDS=604800

# Catalog Service safe database settings.
PLAN_VALIDATOR_CATALOG_DATABASE__HOST=postgres
PLAN_VALIDATOR_CATALOG_DATABASE__PORT=5432
PLAN_VALIDATOR_CATALOG_DATABASE__DATABASE=plan_validator
PLAN_VALIDATOR_CATALOG_DATABASE__USER=plan_validator
PLAN_VALIDATOR_CATALOG_DATABASE__SCHEMA_NAME=catalog
PLAN_VALIDATOR_CATALOG_DATABASE__POOL_SIZE=10
PLAN_VALIDATOR_CATALOG_DATABASE__MAX_OVERFLOW=10
PLAN_VALIDATOR_CATALOG_DATABASE__POOL_TIMEOUT_SECONDS=30

# Persistent managed N/U source storage.
# На host это ./data/catalog, внутри Catalog container — /app/data/catalog.
PLAN_VALIDATOR_CATALOG_SOURCE_STORAGE__ROOT_DIR=data/catalog
PLAN_VALIDATOR_CATALOG_SOURCE_STORAGE__MAX_UPLOAD_BYTES=67108864

# Catalog transactional outbox -> shared RabbitMQ.
PLAN_VALIDATOR_CATALOG_BROKER__HOST=rabbitmq
PLAN_VALIDATOR_CATALOG_BROKER__PORT=5672
PLAN_VALIDATOR_CATALOG_BROKER__USER=plan_validator
PLAN_VALIDATOR_CATALOG_BROKER__VIRTUAL_HOST=/plan-validator
PLAN_VALIDATOR_CATALOG_BROKER__HEARTBEAT_SECONDS=60
PLAN_VALIDATOR_CATALOG_OUTBOX__EXCHANGE_NAME=plan-validator.catalog.events
PLAN_VALIDATOR_CATALOG_OUTBOX__POLL_SECONDS=1
PLAN_VALIDATOR_CATALOG_OUTBOX__FAILURE_BACKOFF_SECONDS=5

# Embedding Service / GPU worker safe settings.
# Existing PDRD Hugging Face volume is mounted read-only to /models/huggingface.
PLAN_VALIDATOR_EMBEDDING_MODEL__NAME=Qwen/Qwen3-VL-Embedding-8B
PLAN_VALIDATOR_EMBEDDING_MODEL__OUTPUT_DIMENSION=4096
PLAN_VALIDATOR_EMBEDDING_MODEL__HF_HOME=/models/huggingface
PLAN_VALIDATOR_EMBEDDING_MODEL__MAX_INPUT_TOKENS=8192
PLAN_VALIDATOR_EMBEDDING_MODEL__MAX_TEXT_CHARS=60000
PLAN_VALIDATOR_EMBEDDING_MODEL__MAX_BATCH_SIZE=1
PLAN_VALIDATOR_EMBEDDING_MODEL__MAX_JOB_ITEMS=256
PLAN_VALIDATOR_EMBEDDING_MODEL__MIN_FREE_RAM_GIB=20
PLAN_VALIDATOR_EMBEDDING_MODEL__MIN_FREE_VRAM_GIB=18
PLAN_VALIDATOR_EMBEDDING_MODEL__ADMISSION_WAIT_TIMEOUT_SECONDS=480
PLAN_VALIDATOR_EMBEDDING_MODEL__ADMISSION_POLL_SECONDS=1
PLAN_VALIDATOR_EMBEDDING_MODEL__GPU_LEASE_PATH=/var/lock/plan-validator-gpu/gpu.lock
PLAN_VALIDATOR_EMBEDDING_MODEL__GPU_LEASE_TIMEOUT_SECONDS=480
PLAN_VALIDATOR_EMBEDDING_MODEL__GPU_LEASE_POLL_SECONDS=0.25
PLAN_VALIDATOR_EMBEDDING_MODEL__DTYPE=bfloat16

PLAN_VALIDATOR_EMBEDDING_BROKER__HOST=rabbitmq
PLAN_VALIDATOR_EMBEDDING_BROKER__PORT=5672
PLAN_VALIDATOR_EMBEDDING_BROKER__USER=plan_validator
PLAN_VALIDATOR_EMBEDDING_BROKER__VIRTUAL_HOST=/plan-validator
PLAN_VALIDATOR_EMBEDDING_BROKER__HEARTBEAT_SECONDS=60

PLAN_VALIDATOR_EMBEDDING_QUEUE__NAME=plan-validator.gpu.embedding
PLAN_VALIDATOR_EMBEDDING_QUEUE__PREFETCH_COUNT=1
PLAN_VALIDATOR_EMBEDDING_QUEUE__RPC_TIMEOUT_SECONDS=600
PLAN_VALIDATOR_EMBEDDING_QUEUE__GRACEFUL_SHUTDOWN_SECONDS=45

# Retrieval Service PostgreSQL registry.
PLAN_VALIDATOR_RETRIEVAL_DATABASE__HOST=postgres
PLAN_VALIDATOR_RETRIEVAL_DATABASE__PORT=5432
PLAN_VALIDATOR_RETRIEVAL_DATABASE__DATABASE=plan_validator
PLAN_VALIDATOR_RETRIEVAL_DATABASE__USER=plan_validator
PLAN_VALIDATOR_RETRIEVAL_DATABASE__SCHEMA_NAME=retrieval
PLAN_VALIDATOR_RETRIEVAL_DATABASE__POOL_SIZE=10
PLAN_VALIDATOR_RETRIEVAL_DATABASE__MAX_OVERFLOW=10
PLAN_VALIDATOR_RETRIEVAL_DATABASE__POOL_TIMEOUT_SECONDS=30

# Retrieval Service Qdrant.
PLAN_VALIDATOR_RETRIEVAL_QDRANT__HOST=qdrant
PLAN_VALIDATOR_RETRIEVAL_QDRANT__HTTP_PORT=6333
PLAN_VALIDATOR_RETRIEVAL_QDRANT__GRPC_PORT=6334
PLAN_VALIDATOR_RETRIEVAL_QDRANT__PREFER_GRPC=true
PLAN_VALIDATOR_RETRIEVAL_QDRANT__TIMEOUT_SECONDS=30
PLAN_VALIDATOR_RETRIEVAL_QDRANT__COLLECTION_NAME=plan_validator_managed_sources_v1
PLAN_VALIDATOR_RETRIEVAL_QDRANT__ALIAS_NAME=plan_validator_managed_sources
PLAN_VALIDATOR_RETRIEVAL_QDRANT__VECTOR_SIZE=4096

# Retrieval Service RabbitMQ contracts.
PLAN_VALIDATOR_RETRIEVAL_BROKER__HOST=rabbitmq
PLAN_VALIDATOR_RETRIEVAL_BROKER__PORT=5672
PLAN_VALIDATOR_RETRIEVAL_BROKER__USER=plan_validator
PLAN_VALIDATOR_RETRIEVAL_BROKER__VIRTUAL_HOST=/plan-validator
PLAN_VALIDATOR_RETRIEVAL_BROKER__HEARTBEAT_SECONDS=60
PLAN_VALIDATOR_RETRIEVAL_QUEUES__CATALOG_EXCHANGE_NAME=plan-validator.catalog.events
PLAN_VALIDATOR_RETRIEVAL_QUEUES__CATALOG_QUEUE_NAME=plan-validator.retrieval.catalog-events
PLAN_VALIDATOR_RETRIEVAL_QUEUES__INDEX_QUEUE_NAME=plan-validator.retrieval.index
PLAN_VALIDATOR_RETRIEVAL_QUEUES__CATALOG_PREFETCH_COUNT=10
PLAN_VALIDATOR_RETRIEVAL_QUEUES__INDEX_PREFETCH_COUNT=1
PLAN_VALIDATOR_RETRIEVAL_QUEUES__EMBEDDING_QUEUE_NAME=plan-validator.gpu.embedding
PLAN_VALIDATOR_RETRIEVAL_QUEUES__RPC_TIMEOUT_SECONDS=600

# Retrieval bounded request/search policy.
PLAN_VALIDATOR_RETRIEVAL_INDEXING__MAX_CHUNKS_PER_SOURCE=256
PLAN_VALIDATOR_RETRIEVAL_INDEXING__MAX_CHUNK_CHARS=8000
PLAN_VALIDATOR_RETRIEVAL_SEARCH__DEFAULT_LIMIT=10
PLAN_VALIDATOR_RETRIEVAL_SEARCH__MAX_LIMIT=50
PLAN_VALIDATOR_RETRIEVAL_SEARCH__DEFAULT_SCORE_THRESHOLD=0.3

# Temporary Project Context PostgreSQL registry.
PLAN_VALIDATOR_CONTEXT_DATABASE__HOST=postgres
PLAN_VALIDATOR_CONTEXT_DATABASE__PORT=5432
PLAN_VALIDATOR_CONTEXT_DATABASE__DATABASE=plan_validator
PLAN_VALIDATOR_CONTEXT_DATABASE__USER=plan_validator
PLAN_VALIDATOR_CONTEXT_DATABASE__SCHEMA_NAME=context
PLAN_VALIDATOR_CONTEXT_DATABASE__POOL_SIZE=10
PLAN_VALIDATOR_CONTEXT_DATABASE__MAX_OVERFLOW=10
PLAN_VALIDATOR_CONTEXT_DATABASE__POOL_TIMEOUT_SECONDS=30

# Temporary Project Context Rabbit/recovery policy.
PLAN_VALIDATOR_CONTEXT_BROKER__HOST=rabbitmq
PLAN_VALIDATOR_CONTEXT_BROKER__PORT=5672
PLAN_VALIDATOR_CONTEXT_BROKER__USER=plan_validator
PLAN_VALIDATOR_CONTEXT_BROKER__VIRTUAL_HOST=/plan-validator
PLAN_VALIDATOR_CONTEXT_BROKER__HEARTBEAT_SECONDS=60

PLAN_VALIDATOR_CONTEXT_QUEUE__INDEX_QUEUE_NAME=plan-validator.context.index
PLAN_VALIDATOR_CONTEXT_QUEUE__PREFETCH_COUNT=1
PLAN_VALIDATOR_CONTEXT_QUEUE__MESSAGE_TTL_MS=900000
PLAN_VALIDATOR_CONTEXT_QUEUE__EXECUTION_TIMEOUT_SECONDS=600
PLAN_VALIDATOR_CONTEXT_QUEUE__JOB_DEADLINE_SECONDS=720
PLAN_VALIDATOR_CONTEXT_QUEUE__MAX_ATTEMPTS=3
PLAN_VALIDATOR_CONTEXT_QUEUE__LEASE_SECONDS=60
PLAN_VALIDATOR_CONTEXT_QUEUE__HEARTBEAT_SECONDS=15
PLAN_VALIDATOR_CONTEXT_QUEUE__RECONCILE_SECONDS=5
PLAN_VALIDATOR_CONTEXT_QUEUE__RETRY_BACKOFF_BASE_SECONDS=5
PLAN_VALIDATOR_CONTEXT_QUEUE__RETRY_BACKOFF_MAX_SECONDS=60
PLAN_VALIDATOR_CONTEXT_QUEUE__RECONCILIATION_BATCH_SIZE=50
PLAN_VALIDATOR_CONTEXT_QUEUE__GRACEFUL_SHUTDOWN_SECONDS=45

PLAN_VALIDATOR_CONTEXT_RETENTION__GRACE_HOURS=24

PLAN_VALIDATOR_CONTEXT_INDEXING__MAX_CHUNKS_PER_SOURCE=256
PLAN_VALIDATOR_CONTEXT_INDEXING__MAX_CHUNK_CHARS=8000

PLAN_VALIDATOR_CONTEXT_EMBEDDING__MODEL_NAME=Qwen/Qwen3-VL-Embedding-8B
PLAN_VALIDATOR_CONTEXT_EMBEDDING__VECTOR_DIMENSION=4096
PLAN_VALIDATOR_CONTEXT_EMBEDDING__QUEUE_NAME=plan-validator.gpu.embedding
PLAN_VALIDATOR_CONTEXT_EMBEDDING__RPC_TIMEOUT_SECONDS=480

PLAN_VALIDATOR_CONTEXT_QDRANT__HOST=qdrant
PLAN_VALIDATOR_CONTEXT_QDRANT__HTTP_PORT=6333
PLAN_VALIDATOR_CONTEXT_QDRANT__GRPC_PORT=6334
PLAN_VALIDATOR_CONTEXT_QDRANT__PREFER_GRPC=true
PLAN_VALIDATOR_CONTEXT_QDRANT__TIMEOUT_SECONDS=30
PLAN_VALIDATOR_CONTEXT_QDRANT__COLLECTION_PREFIX=plan_validator

PLAN_VALIDATOR_CONTEXT_SEARCH__DEFAULT_LIMIT=10
PLAN_VALIDATOR_CONTEXT_SEARCH__MAX_LIMIT=50
PLAN_VALIDATOR_CONTEXT_SEARCH__DEFAULT_SCORE_THRESHOLD=0.3
PLAN_VALIDATOR_CONTEXT_SEARCH__MAX_QUERY_CHARS=60000

# Project-specific PostgreSQL infrastructure.
PLAN_VALIDATOR_POSTGRES_IMAGE=postgres:16-alpine
PLAN_VALIDATOR_POSTGRES_DB=plan_validator
PLAN_VALIDATOR_POSTGRES_USER=plan_validator
PLAN_VALIDATOR_POSTGRES_HOST_PORT=5438

# Private real value is generated into `.env`.
PLAN_VALIDATOR_POSTGRES_PASSWORD=CHANGE_ME_GENERATED_AUTOMATICALLY

# Project-specific Qdrant infrastructure.
PLAN_VALIDATOR_QDRANT_IMAGE=qdrant/qdrant:v1.19.0
PLAN_VALIDATOR_QDRANT_HTTP_HOST_PORT=6335
PLAN_VALIDATOR_QDRANT_GRPC_HOST_PORT=6336

# Docker networks.
PLAN_VALIDATOR_PRIVATE_NETWORK_NAME=plan-validator-private
PLAN_VALIDATOR_SHARED_NETWORK_NAME=ai-shared

# Shared infrastructure repository.
PLAN_VALIDATOR_SHARED_INFRA_DIR=../shared_infrasktructure

# Shared Ollama.
PLAN_VALIDATOR_OLLAMA_MODEL=qwen3-vl:8b-instruct

# Project-specific resources внутри shared RabbitMQ.
PLAN_VALIDATOR_RABBITMQ_USER=plan_validator
PLAN_VALIDATOR_RABBITMQ_VHOST=/plan-validator

# Queue reliability policies scoped only to /plan-validator.
# TTL ограничивает queued/ready messages, consumer timeout — unacked delivery.
PLAN_VALIDATOR_RABBITMQ_WORK_QUEUE_TTL_MS=900000
PLAN_VALIDATOR_RABBITMQ_WORK_QUEUE_CONSUMER_TIMEOUT_MS=720000
PLAN_VALIDATOR_RABBITMQ_CATALOG_EVENT_QUEUE_TTL_MS=604800000
PLAN_VALIDATOR_RABBITMQ_CATALOG_EVENT_QUEUE_CONSUMER_TIMEOUT_MS=300000

# Private real value is generated into `.env`.
PLAN_VALIDATOR_RABBITMQ_PASSWORD=CHANGE_ME_GENERATED_AUTOMATICALLY

# Structured application logging.
PLAN_VALIDATOR_LOG_LEVEL=INFO
PLAN_VALIDATOR_LOG_ROOT_DIR=var/log
PLAN_VALIDATOR_LOG_TO_FILE=true
PLAN_VALIDATOR_LOG_FILE_MAX_BYTES=20971520
PLAN_VALIDATOR_LOG_FILE_BACKUP_COUNT=7

# Bounded Docker stdout/stderr logs.
PLAN_VALIDATOR_DOCKER_LOG_MAX_SIZE=10m
PLAN_VALIDATOR_DOCKER_LOG_MAX_FILE=5

# Retention baseline.
PLAN_VALIDATOR_TEMPORARY_CONTEXT_GRACE_HOURS=24
PLAN_VALIDATOR_STALE_UPLOAD_TTL_HOURS=24
PLAN_VALIDATOR_PROCESSING_ARTIFACT_TTL_HOURS=24
PLAN_VALIDATOR_RESULT_RETENTION_DAYS=30
PLAN_VALIDATOR_LOG_RETENTION_DAYS=14