# .gitignore
#
# Локальные окружения, секреты, runtime-артефакты и кэши plan-validator.
# В Git должны попадать исходный код, миграции, документация и безопасный
# baseline `.env.example`, но не локальные credentials и сгенерированные данные.

# Python
__pycache__/
*.py[cod]
*.so
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

# Virtual environments
.venv/
venv/
env/

# Environment and secrets
.env
.env.*
!.env.example

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Runtime data
var/
data/runtime/
data/tmp/
data/uploads/
data/results/
logs/

# Persistent managed N/U data.
# Сам каталог существует в Git через .gitkeep, пользовательские документы — нет.
data/catalog/*
!data/catalog/.gitkeep

# Local model/cache data
.cache/
models/cache/
huggingface/

# Test / benchmark artifacts
artifacts/
benchmarks/results/

# Build artifacts
build/
dist/
*.egg-info/